# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to GitHub.

# Anthropic (Claude) API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Clerk (authentication) — https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Postgres (database) — created via the Vercel dashboard's Storage tab,
# then pulled locally with: vercel env pull .env.local
POSTGRES_URL=postgres://...
