# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (auth + database) -> Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic (Claude) API key -> https://console.anthropic.com/settings/keys  (server-only secret)
ANTHROPIC_API_KEY=sk-ant-...

# Shown on the Privacy Notice, Terms and Account pages (optional but recommended)
# NEXT_PUBLIC_OPERATOR_NAME=Name of the person or organisation running the app
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Optional
# Model used for generation and stress tests (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# Restrict sign-ups and AI use to these email domains (comma-separated). Unset = anyone.
# ALLOWED_EMAIL_DOMAINS=lpu.co.in,lpu.in
# Per-account caps per rolling 24 hours (defaults: 15 and 10)
# DAILY_GENERATION_LIMIT=15
# DAILY_STRESS_TEST_LIMIT=10
